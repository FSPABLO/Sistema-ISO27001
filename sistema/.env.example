# Copie este archivo como .env y cambie los valores. No suba .env a ningún repositorio.

# Administrador inicial (solo se crea si la base del sistema está vacía; debe cambiar la clave al ingresar)
ADMIN_USER=admin
ADMIN_PASSWORD=Cambie_Esta_Clave_2026

# Secreto para firmar la cookie de sesión (genere uno con: openssl rand -hex 32)
SESSION_SECRET=cambie-este-valor-por-uno-aleatorio-de-64-caracteres-hexadecimales

# Permite que cualquiera cree su propia cuenta (rol analista) desde la pantalla de inicio de sesión
PERMITIR_REGISTRO=true

# Minutos de inactividad antes de cerrar la sesión
SESION_INACTIVIDAD_MIN=20

# true solo si el sistema se publica detrás de HTTPS
COOKIE_SECURE=false

# Tiempo máximo de cada prueba (milisegundos)
TIMEOUT_PRUEBA_MS=20000

# --- Solo para las pruebas de punta a punta (docker compose --profile e2e run --rm e2e) ---
# Claves de prueba del laboratorio; no se usan en el funcionamiento normal del sistema.
# Contraseña del administrador de la instancia desechable de pruebas (12+ caracteres, sin la palabra admin)
E2E_ADMIN_CLAVE=
E2E_CLAVE_ISO_AUDIT=
E2E_CLAVE_SEGCONF=
E2E_CLAVE_APP_CONSULTA=
E2E_CLAVE_APP_SOPORTE=
E2E_CLAVE_APP_REPORTES=
E2E_CLAVE_SEGCONF_DEV=
